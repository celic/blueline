<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Blueline.Core\Blueline.Core.csproj" />
    <ProjectReference Include="..\Blueline.Data\Blueline.Data.csproj" />
    <ProjectReference Include="..\Blueline.Ingestion\Blueline.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>


  <!-- The season archive ships with the app so a fresh database can be filled without
       touching the league's API. -->
  <ItemGroup>
    <Content Include="..\..\seed\*.blueline.gz" Link="seed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

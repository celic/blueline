@inherits LayoutComponentBase

@* First thing in the tab order: five nav links stand between the top of every page and its
   content, and a keyboard reader should not have to walk them on each navigation. *@
<a class="skip-link" href="#content">Skip to content</a>

<header class="topbar">
    <a class="brand" href="/"><span class="brand-mark"></span>Blueline</a>
    <nav class="nav">
        @* Match.All so the brand's own destination does not light up on every page. *@
        <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink href="/leaders">Leaders</NavLink>
        <NavLink href="/players">Players</NavLink>
        <NavLink href="/goalies">Goalies</NavLink>
        <NavLink href="/teams">Teams</NavLink>
        <NavLink href="/data">Data</NavLink>
    </nav>
</header>

<main class="page" id="content" tabindex="-1">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

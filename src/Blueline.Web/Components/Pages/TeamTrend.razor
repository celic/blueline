@page "/teams/{TeamId:int}"
@rendermode InteractiveServer
@inject StatsQueryService Queries
@inject IOptions<DisplayOptions> Display
@using Microsoft.Extensions.Options

<PageTitle>@(_series?.SubjectName ?? "Team") — Blueline</PageTitle>

@if (_series is null || _series.Points.Count == 0)
{
    <div class="empty">No stored games for this team in @StatsQueryService.FormatSeason(_seasonId).</div>
}
else
{
    <div class="page-head">
        <h1>@_series.SubjectName</h1>
        <p>@_series.StatLabel across @_series.Points.Count games of @StatsQueryService.FormatSeason(_seasonId) · @_scope.Label().ToLowerInvariant()</p>
    </div>

    <div class="controls">
        <div class="field">
            <label for="stat">Stat</label>
            <select id="stat" value="@_stat" @onchange="OnStatChanged">
                @foreach (var stat in StatDefinition.Team)
                {
                    <option value="@stat.Key">@stat.Label</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="season">Season</label>
            <select id="season" value="@_seasonId" @onchange="OnSeasonChanged">
                @foreach (var season in _seasons)
                {
                    <option value="@season.SeasonId">@season.Label</option>
                }
            </select>
        </div>

        <ScopePicker Scope="_scope" ScopeChanged="OnScopeChanged" />

        <div class="field">
            <label>View</label>
            <div class="segmented">
                <button class="@(_cumulative ? "on" : "")" @onclick="() => SetView(true)">Cumulative</button>
                <button class="@(!_cumulative ? "on" : "")" @onclick="() => SetView(false)">Per game</button>
            </div>
        </div>

        @if (!_cumulative)
        {
            <div class="field">
                <label for="window">Rolling window</label>
                <select id="window" value="@_window" @onchange="OnWindowChanged">
                    @foreach (var w in new[] { 5, 10, 15, 20 })
                    {
                        <option value="@w">@w games</option>
                    }
                </select>
            </div>
        }

        <ComparePicker Label="Compare with"
                       Placeholder="Search teams…"
                       Search="SearchComparisonsAsync"
                       OnSelected="AddComparisonAsync"
                       Capacity="ChartPalette.MaxComparisons"
                       SelectedCount="_comparisons.Count" />
    </div>

    @if (_comparisons.Count > 0)
    {
        <div class="compare-list">
            @foreach (var (series, index) in _comparisons.Select((s, i) => (s, i)))
            {
                <span class="chip">
                    <span class="swatch" style="background:@ChartPalette.For(index + 1)"></span>
                    @series.SubjectName
                    <button title="Remove" @onclick="() => RemoveComparison(series.SubjectId)">×</button>
                </span>
            }
        </div>
    }

    <div class="card">
        <div class="stat-row">
            <div>
                <div class="value">@_series.Total.ToString("0")</div>
                <div class="label">Total @_series.StatLabel.ToLowerInvariant()</div>
            </div>
            <div>
                <div class="value">@_series.PerGame.ToString("F2")</div>
                <div class="label">Per game</div>
            </div>
            <div>
                <div class="value">@_record</div>
                <div class="label">Record</div>
            </div>
        </div>
        @if (_stat == "points" && !_scope.HasStandingsPoints())
        {
            <p class="muted">
                Standings points are a regular-season concept — playoff games award none, so this
                line flattens wherever the playoffs begin. Switch the games filter to the regular
                season, or pick another stat.
            </p>
        }
        <TrendChart Spec="_spec" @key="_chartKey" />
    </div>
}

@code {
    [Parameter] public int TeamId { get; set; }
    [SupplyParameterFromQuery(Name = "season")] public int? SeasonQuery { get; set; }

    private IReadOnlyList<SeasonSummary> _seasons = [];
    private readonly List<TrendSeries> _comparisons = [];
    private TrendSeries? _series;
    private ChartSpec? _spec;
    private string _record = "";

    private int _seasonId;
    private string _stat = "points";
    private int _window = 10;
    private bool _cumulative = true;
    private GameScope _scope;
    private string _chartKey = "";

    protected override async Task OnParametersSetAsync()
    {
        _seasons = await Queries.GetSeasonsAsync();
        if (_seasons.Count == 0) return;

        _seasonId = SeasonQuery ?? _seasons[0].SeasonId;
        _scope = Display.Value.DefaultGameScope;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _series = await Queries.GetTeamTrendAsync(TeamId, _seasonId, _stat, _window, _scope);

        var standings = await Queries.GetTeamsAsync(_seasonId, _scope);
        var team = standings.FirstOrDefault(t => t.Id == TeamId);
        _record = team is null ? "" : $"{team.Wins}-{team.Losses}-{team.OvertimeLosses}";

        // Comparisons are held by id, so re-fetch them whenever the stat or season moves.
        var comparisonIds = _comparisons.Select(c => c.SubjectId).ToList();
        _comparisons.Clear();
        foreach (var id in comparisonIds)
        {
            var series = await Queries.GetTeamTrendAsync(id, _seasonId, _stat, _window, _scope);
            if (series is not null) _comparisons.Add(series);
        }

        BuildSpec();
    }

    /// <summary>Two clubs' points pace on one chart is the natural way to read a playoff race.</summary>
    private async Task<IReadOnlyList<ComparePicker.Option>> SearchComparisonsAsync(string term)
    {
        var teams = await Queries.GetTeamsAsync(_seasonId, _scope);

        return teams
            .Where(t => t.Id != TeamId && _comparisons.All(c => c.SubjectId != t.Id))
            .Where(t => t.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                        || t.Abbrev.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Select(t => new ComparePicker.Option(
                t.Id, t.Name, _scope.HasStandingsPoints() ? $"{t.StandingsPoints} PTS" : $"{t.Wins}-{t.Losses}"))
            .ToList();
    }

    private async Task AddComparisonAsync(int teamId)
    {
        if (_comparisons.Count >= ChartPalette.MaxComparisons) return;

        var series = await Queries.GetTeamTrendAsync(teamId, _seasonId, _stat, _window, _scope);
        if (series is not null && series.Points.Count > 0)
        {
            _comparisons.Add(series);
            BuildSpec();
        }
    }

    private void RemoveComparison(int teamId)
    {
        _comparisons.RemoveAll(c => c.SubjectId == teamId);
        BuildSpec();
    }

    private async Task OnScopeChanged(GameScope scope)
    {
        _scope = scope;
        await LoadAsync();
    }

    private void BuildSpec()
    {
        if (_series is null || _series.Points.Count == 0)
        {
            _spec = null;
            return;
        }

        var all = new List<TrendSeries> { _series };
        all.AddRange(_comparisons);

        // The longest season sets the axis so every club stays aligned by game number.
        var length = all.Max(s => s.Points.Count);
        var labels = Enumerable.Range(1, length).Select(i => i.ToString()).ToList();
        var datasets = new List<ChartDataset>();

        for (var i = 0; i < all.Count; i++)
        {
            var series = all[i];
            var colour = ChartPalette.For(i);

            if (_cumulative)
            {
                datasets.Add(new ChartDataset(
                    all.Count == 1 ? series.StatLabel : series.SubjectName,
                    Pad(series.Points.Select(p => (double?)p.Cumulative), length),
                    colour,
                    Fill: all.Count == 1));
            }
            else
            {
                // Overlapping bars are unreadable, so they stay only in the single-club view.
                if (all.Count == 1)
                {
                    datasets.Add(new ChartDataset(
                        "Per game", Pad(series.Points.Select(p => (double?)p.Value), length), "#475569", Kind: "bar"));
                }

                datasets.Add(new ChartDataset(
                    all.Count == 1 ? $"{_window}-game average" : series.SubjectName,
                    Pad(series.Points.Select(p => p.RollingAverage), length),
                    colour));
            }
        }

        var subtitles = _series.Points
            .Select(p => $"Game {p.GameNumber} — {(p.IsHome ? "vs" : "@")} {p.Opponent} · {p.Date:MMM d}")
            .ToList();

        _spec = new ChartSpec(
            labels,
            datasets,
            XLabel: "Game number",
            YLabel: _cumulative ? $"Cumulative {_series.StatLabel.ToLowerInvariant()}" : _series.StatLabel,
            // Goal differential swings negative, so pinning the axis to zero would hide the shape.
            BeginAtZero: _stat != "goalDifferential",
            Precise: !_cumulative,
            Subtitles: subtitles);

        _chartKey = $"{TeamId}-{_seasonId}-{_scope}-{_stat}-{_window}-{_cumulative}-{_comparisons.Count}";
    }

    /// <summary>Pads a shorter run with nulls so every club stays on one x axis.</summary>
    private static List<double?> Pad(IEnumerable<double?> values, int length)
    {
        var list = values.ToList();
        while (list.Count < length) list.Add(null);
        return list;
    }

    private async Task OnStatChanged(ChangeEventArgs e)
    {
        _stat = e.Value?.ToString() ?? "points";
        await LoadAsync();
    }

    private async Task OnSeasonChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seasonId)) _seasonId = seasonId;
        await LoadAsync();
    }

    private async Task OnWindowChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var window)) _window = window;
        await LoadAsync();
    }

    private void SetView(bool cumulative)
    {
        _cumulative = cumulative;
        BuildSpec();
    }
}

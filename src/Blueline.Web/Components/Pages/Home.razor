@page "/"
@rendermode InteractiveServer
@inject StatsQueryService Queries

@*
    The landing page. Deliberately thin for now: this is where the streaks dashboard goes
    (plan.md group 6), and it was given its own empty page rather than being grafted onto the
    leaders table that used to live here.

    Thin is not the same as unfinished, though — a visitor arriving at the root should be able to
    reach anything the site does and see that it holds real data, which is what this covers until
    the panels land.
*@

<PageTitle>Blueline — Hockey stats as trends</PageTitle>

<div class="page-head">
    <h1>Blueline</h1>
    <p>Hockey statistics as trends over time — how a season actually unfolded, game by game.</p>
</div>

@if (_seasons.Count == 0)
{
    <div class="empty">
        No games stored yet. Load a season with <code>dotnet run --project src/Blueline.Cli -- backfill 20252026</code>.
    </div>
}
else
{
    <div class="tiles">
        <a class="card tile" href="/leaders">
            <h2>Leaders</h2>
            <p class="muted">Who is ahead, for any stat the box score carries.</p>
        </a>
        <a class="card tile" href="/players">
            <h2>Players</h2>
            <p class="muted">Search any skater and chart their season. Overlay up to five.</p>
        </a>
        <a class="card tile" href="/goalies">
            <h2>Goalies</h2>
            <p class="muted">Save percentage and workload, weighted by shots rather than averaged.</p>
        </a>
        <a class="card tile" href="/teams">
            <h2>Teams</h2>
            <p class="muted">Standings, and how each club banked its points across the year.</p>
        </a>
    </div>

    <div class="card" style="margin-top:1.25rem">
        <p class="muted" style="margin:0">
            @_gamesStored.ToString("N0") games stored across
            @(_seasons.Count == 1 ? "one season" : $"{_seasons.Count} seasons"),
            @_seasons[^1].Label to @_seasons[0].Label.
            <a href="/data">Where the data came from</a>.
        </p>
    </div>
}

@code {
    private IReadOnlyList<SeasonSummary> _seasons = [];
    private int _gamesStored;

    protected override async Task OnInitializedAsync()
    {
        _seasons = await Queries.GetSeasonsAsync();
        _gamesStored = _seasons.Sum(s => s.GameCount);
    }
}

@page "/players/{PlayerId:int}"
@rendermode InteractiveServer
@inject StatsQueryService Queries
@inject NavigationManager Nav
@inject IOptions<DisplayOptions> Display
@using Microsoft.Extensions.Options

<PageTitle>@(_primary?.SubjectName ?? "Player") — Blueline</PageTitle>

@* A known player with no games in the chosen season or scope comes back as an empty series, not
   as null, so both cases have to be handled — otherwise the page renders stat tiles reading zero
   above a blank chart. The goalie and team pages already do this. *@
@if (_primary is null || _primary.Points.Count == 0)
{
    <div class="empty">
        No stored games for this player in @StatsQueryService.FormatSeason(_seasonId)
        (@_scope.Label().ToLowerInvariant()).
    </div>
}
else
{
    <div class="page-head">
        <div class="player-head">
            @if (_headshotUrl is not null)
            {
                <img src="@_headshotUrl" alt="" />
            }
            <div>
                <h1>@_primary.SubjectName</h1>
                <p>@_primary.StatLabel through @_primary.Points.Count games of @StatsQueryService.FormatSeason(_seasonId) · @_scope.Label().ToLowerInvariant()</p>
            </div>
        </div>
    </div>

    <div class="controls">
        <div class="field">
            <label for="stat">Stat</label>
            <select id="stat" value="@_stat" @onchange="OnStatChanged">
                @foreach (var stat in StatDefinition.Skater)
                {
                    <option value="@stat.Key">@stat.Label</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="season">Season</label>
            <select id="season" value="@_seasonId" @onchange="OnSeasonChanged">
                @foreach (var season in _seasons)
                {
                    <option value="@season.SeasonId">@season.Label</option>
                }
            </select>
        </div>

        <ScopePicker Scope="_scope" ScopeChanged="OnScopeChanged" />

        <div class="field">
            <label>X axis</label>
            <div class="segmented">
                <button class="@(!_timeAxis ? "on" : "")" @onclick="() => SetAxis(false)">Game</button>
                <button class="@(_timeAxis ? "on" : "")" @onclick="() => SetAxis(true)">Date</button>
            </div>
        </div>

        <div class="field">
            <label>View</label>
            <div class="segmented">
                <button class="@(_view == ViewMode.Cumulative ? "on" : "")"
                        @onclick="() => SetView(ViewMode.Cumulative)">Cumulative</button>
                <button class="@(_view == ViewMode.PerGame ? "on" : "")"
                        @onclick="() => SetView(ViewMode.PerGame)">Per game</button>
            </div>
        </div>

        @if (_view == ViewMode.PerGame)
        {
            <div class="field">
                <label for="window">Rolling window</label>
                @* Both units in one control: they answer the same question, measured
                   differently, and a second dropdown would imply otherwise. *@
                <select id="window" value="@_window.Token" @onchange="OnWindowChanged">
                    @foreach (var w in RollingWindow.Choices)
                    {
                        <option value="@w.Token">@w.OptionLabel</option>
                    }
                </select>
            </div>
        }

        <ComparePicker Label="Compare with"
                       Placeholder="Search players…"
                       Search="SearchComparisonsAsync"
                       OnSelected="AddComparisonAsync"
                       Capacity="ChartPalette.MaxComparisons"
                       SelectedCount="_comparisons.Count" />
    </div>

    @if (_comparisons.Count > 0)
    {
        <div class="compare-list">
            @foreach (var (series, index) in _comparisons.Select((s, i) => (s, i)))
            {
                <span class="chip">
                    <span class="swatch" style="background:@ChartPalette.For(index + 1)"></span>
                    @series.SubjectName
                    <button title="Remove" @onclick="() => RemoveComparison(series.SubjectId)">×</button>
                </span>
            }
        </div>
    }

    <div class="grid-2" style="margin-top:1.25rem">
        <div class="card">
            <div class="stat-row">
                <div>
                    <div class="value">@Format(_primary.Total)</div>
                    <div class="label">Total @_primary.StatLabel</div>
                </div>
                <div>
                    <div class="value">@Format(_primary.PerGame, 2)</div>
                    <div class="label">Per game</div>
                </div>
                <div>
                    <div class="value">@Format(BestStretch())</div>
                    <div class="label">Best @_window.Label stretch</div>
                </div>
            </div>
            <TrendChart Spec="_spec" @key="_chartKey" />
        </div>

        <div class="card">
            <h2>Game log</h2>
            <div class="table-scroll" style="max-height:420px; overflow-y:auto">
                <table>
                    <thead>
                        <tr>
                            <th class="rank">#</th>
                            <th>Date</th>
                            <th>Opp</th>
                            <th class="num">@(StatDefinition.FindSkater(_stat)?.Unit)</th>
                            <th class="num">Tot</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in _primary.Points.AsEnumerable().Reverse())
                        {
                            <tr>
                                <td class="rank">@point.GameNumber</td>
                                <td class="muted">@point.Date.ToString("MMM d")</td>
                                <td>@(point.IsHome ? "vs" : "@") @point.Opponent</td>
                                <td class="num">@Format(point.Value, 1)</td>
                                <td class="num muted">@Format(point.Cumulative)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int PlayerId { get; set; }

    [SupplyParameterFromQuery(Name = "season")] public int? SeasonQuery { get; set; }
    [SupplyParameterFromQuery(Name = "stat")] public string? StatQuery { get; set; }

    /// <summary>
    /// Carried so a link can arrive on the same window the reader was already looking at — the
    /// dashboard's panels link here, and landing on a ten-game average after reading a fourteen-day
    /// one would quietly show different numbers than the ones that were clicked.
    /// </summary>
    [SupplyParameterFromQuery(Name = "window")] public string? WindowQuery { get; set; }

    private enum ViewMode { Cumulative, PerGame }

    private IReadOnlyList<SeasonSummary> _seasons = [];
    private readonly List<TrendSeries> _comparisons = [];

    private TrendSeries? _primary;
    private ChartSpec? _spec;
    private string? _headshotUrl;

    private int _seasonId;
    private string _stat = "points";
    private RollingWindow _window = RollingWindow.Default;
    private ViewMode _view = ViewMode.Cumulative;
    private GameScope _scope;
    private bool _timeAxis;

    // Forces the chart component to rebuild rather than patch a stale canvas.
    private string _chartKey = "";

    protected override async Task OnParametersSetAsync()
    {
        _seasons = await Queries.GetSeasonsAsync();
        if (_seasons.Count == 0) return;

        _seasonId = SeasonQuery ?? _seasons[0].SeasonId;
        _scope = Display.Value.DefaultGameScope;

        // Goalies record none of the skater stats this page charts, so send them to the page
        // built for them rather than rendering an empty season.
        var player = await Queries.GetPlayerAsync(PlayerId);
        if (player?.IsGoalie == true)
        {
            Nav.NavigateTo($"/goalies/{PlayerId}?season={_seasonId}", replace: true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(StatQuery) && StatDefinition.FindSkater(StatQuery) is not null)
            _stat = StatQuery;

        if (!string.IsNullOrWhiteSpace(WindowQuery)) _window = RollingWindow.Parse(WindowQuery);

        await LoadCandidatesAsync();
        await LoadAsync();
    }

    private async Task LoadCandidatesAsync() =>
        _headshotUrl = (await Queries.GetPlayerAsync(PlayerId))?.HeadshotUrl;

    /// <summary>
    /// Searches the whole league rather than offering a fixed slice of it. The previous dropdown
    /// listed the top 40 scorers, so 1,023 players — every depth forward, most defencemen — could
    /// not be compared at all, and nothing on screen said so.
    /// </summary>
    private async Task<IReadOnlyList<ComparePicker.Option>> SearchComparisonsAsync(string term)
    {
        var matches = await Queries.SearchPlayersAsync(_seasonId, term, 20, _scope);

        return matches
            .Where(m => m.Id != PlayerId && _comparisons.All(c => c.SubjectId != m.Id))
            .Select(m => new ComparePicker.Option(
                m.Id, m.FullName, $"{m.TeamAbbrev} · {m.Points} P"))
            .ToList();
    }

    private async Task OnScopeChanged(GameScope scope)
    {
        _scope = scope;
        await LoadCandidatesAsync();
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        _primary = await Queries.GetPlayerTrendAsync(PlayerId, _seasonId, _stat, _window, _scope);

        // Comparisons are held by id, so re-fetch them whenever the stat or season moves.
        var comparisonIds = _comparisons.Select(c => c.SubjectId).ToList();
        _comparisons.Clear();
        foreach (var id in comparisonIds)
        {
            var series = await Queries.GetPlayerTrendAsync(id, _seasonId, _stat, _window, _scope);
            if (series is not null) _comparisons.Add(series);
        }

        BuildSpec();
    }

    private void BuildSpec()
    {
        if (_primary is null || _primary.Points.Count == 0)
        {
            _spec = null;
            return;
        }

        var all = new List<TrendSeries> { _primary };
        all.AddRange(_comparisons);

        // The longest season sets the x axis so every compared player stays aligned by game number.
        var length = all.Max(s => s.Points.Count);
        var labels = Enumerable.Range(1, length).Select(i => i.ToString()).ToList();

        var datasets = new List<ChartDataset>();

        for (var i = 0; i < all.Count; i++)
        {
            var series = all[i];
            var color = ChartPalette.For(i);

            if (_view == ViewMode.Cumulative)
            {
                datasets.Add(TrendDatasets.From(
                    series.SubjectName, series.Points, p => p.Cumulative, color, _timeAxis, length,
                    fill: all.Count == 1));
            }
            else
            {
                // Raw per-game values are spiky, so the rolling average carries the trend and the
                // bars stay only for the single-player view where they are still readable.
                if (all.Count == 1)
                {
                    datasets.Add(TrendDatasets.From(
                        "Per game", series.Points, p => p.Value, "#475569", _timeAxis, length, kind: "bar"));
                }

                datasets.Add(TrendDatasets.From(
                    all.Count == 1 ? $"{_window.Label} average" : series.SubjectName,
                    series.Points, p => p.RollingAverage, color, _timeAxis, length));
            }
        }

        var subtitles = _primary.Points
            .Select(p => $"Game {p.GameNumber} — {(p.IsHome ? "vs" : "@")} {p.Opponent} · {p.Date:MMM d}")
            .ToList();

        _spec = new ChartSpec(
            labels,
            datasets,
            XLabel: _timeAxis ? "Date" : "Game number",
            YLabel: _view == ViewMode.Cumulative
                ? $"Cumulative {_primary.StatLabel.ToLowerInvariant()}"
                : $"{_primary.StatLabel} per game",
            BeginAtZero: _stat != "plusMinus",
            Precise: _view == ViewMode.PerGame,
            Subtitles: subtitles,
            TimeAxis: _timeAxis);

        _chartKey = $"{PlayerId}-{_seasonId}-{_scope}-{_stat}-{_window.Token}-{_view}-{_timeAxis}-{_comparisons.Count}";
    }

    /// <summary>Pads a shorter season with nulls so Chart.js keeps every series on one x axis.</summary>
    private static List<double?> Pad(IEnumerable<double?> values, int length)
    {
        var list = values.ToList();
        while (list.Count < length) list.Add(null);
        return list;
    }

    /// <summary>
    /// The player's hottest stretch — the headline number a trend view should answer.
    ///
    /// Reads the window's own total rather than multiplying its average by the window size. Those
    /// agree only when the window is counted in games; over fourteen days a player might play four
    /// times or eight, and multiplying by fourteen would report a figure they never came close to.
    ///
    /// Falls back to the season total when no window is full — a season shorter than the window
    /// has no stretch to speak of, and its whole output is the answer.
    /// </summary>
    private double BestStretch()
    {
        if (_primary is null || _primary.Points.Count == 0) return 0;

        var totals = _primary.Points.Where(p => p.RollingTotal is not null).Select(p => p.RollingTotal!.Value).ToList();
        return Math.Round(totals.Count > 0 ? totals.Max() : _primary.Total, 1);
    }

    private async Task OnStatChanged(ChangeEventArgs e)
    {
        _stat = e.Value?.ToString() ?? "points";
        await LoadAsync();
    }

    private async Task OnSeasonChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seasonId)) _seasonId = seasonId;
        await LoadCandidatesAsync();
        await LoadAsync();
    }

    private async Task OnWindowChanged(ChangeEventArgs e)
    {
        _window = RollingWindow.Parse(e.Value?.ToString());
        await LoadAsync();
    }

    private void SetView(ViewMode mode)
    {
        _view = mode;
        BuildSpec();
    }

    private void SetAxis(bool timeAxis)
    {
        _timeAxis = timeAxis;
        BuildSpec();
    }


    private async Task AddComparisonAsync(int playerId)
    {
        if (_comparisons.Count >= ChartPalette.MaxComparisons) return;

        var series = await Queries.GetPlayerTrendAsync(playerId, _seasonId, _stat, _window, _scope);
        if (series is not null && series.Points.Count > 0)
        {
            _comparisons.Add(series);
            BuildSpec();
        }
    }

    private void RemoveComparison(int playerId)
    {
        _comparisons.RemoveAll(c => c.SubjectId == playerId);
        BuildSpec();
    }

    private static string Format(double value, int decimals = 1) =>
        Math.Abs(value % 1) < 0.001 && decimals == 1 ? value.ToString("0") : value.ToString($"F{decimals}");
}

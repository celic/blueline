@page "/teams"
@rendermode InteractiveServer
@inject StatsQueryService Queries
@inject IOptions<DisplayOptions> Display
@using Microsoft.Extensions.Options

<PageTitle>Teams — Blueline</PageTitle>

<div class="page-head">
    <h1>Teams</h1>
    <p>Records for the selected games. Open a team to see how its season unfolded.</p>
</div>

<div class="controls">
    <ScopePicker Scope="_scope" ScopeChanged="OnScopeChanged" />
    <div class="field">
        <label for="season">Season</label>
        <select id="season" value="@_seasonId" @onchange="OnSeasonChanged">
            @foreach (var season in _seasons)
            {
                <option value="@season.SeasonId">@season.Label</option>
            }
        </select>
    </div>
</div>

@if (_teams.Count == 0)
{
    <div class="empty">No team records stored for this season.</div>
}
else
{
    <div class="card">
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th class="rank">#</th>
                        <th>Team</th>
                        <th class="num">GP</th>
                        <th class="num">W</th>
                        <th class="num">L</th>
                        @if (_showStandingsPoints)
                        {
                            <th class="num">OTL</th>
                            <th class="num">PTS</th>
                            <th class="num">PTS%</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (team, index) in _teams.Select((t, i) => (t, i)))
                    {
                        <tr>
                            <td class="rank">@(index + 1)</td>
                            <td>
                                <a href="/teams/@team.Id?season=@_seasonId">
                                    @if (team.LogoUrl is not null)
                                    {
                                        <img class="headshot" src="@team.LogoUrl" alt="" loading="lazy" />
                                    }
                                    @team.Name
                                </a>
                            </td>
                            <td class="num muted">@team.GamesPlayed</td>
                            <td class="num">@team.Wins</td>
                            <td class="num">@team.Losses</td>
                            @if (_showStandingsPoints)
                            {
                                <td class="num">@team.OvertimeLosses</td>
                                <td class="num"><strong>@team.StandingsPoints</strong></td>
                                <td class="num muted">@PointsPercentage(team).ToString("F3")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private IReadOnlyList<SeasonSummary> _seasons = [];
    private IReadOnlyList<TeamSummary> _teams = [];
    private int _seasonId;
    private GameScope _scope;

    // The playoffs award no standings points, so those columns would be meaningless — and a
    // combined view would show a regular-season points total beside a combined win count.
    private bool _showStandingsPoints => _scope.HasStandingsPoints();

    protected override async Task OnInitializedAsync()
    {
        _seasons = await Queries.GetSeasonsAsync();
        if (_seasons.Count == 0) return;

        _seasonId = _seasons[0].SeasonId;
        _scope = Display.Value.DefaultGameScope;
        await LoadAsync();
    }

    private async Task LoadAsync() => _teams = await Queries.GetTeamsAsync(_seasonId, _scope);

    private async Task OnScopeChanged(GameScope scope)
    {
        _scope = scope;
        await LoadAsync();
    }

    private async Task OnSeasonChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seasonId)) _seasonId = seasonId;
        await LoadAsync();
    }

    /// <summary>Share of the two points available per game — the fair way to compare uneven games played.</summary>
    private static double PointsPercentage(TeamSummary team) =>
        team.GamesPlayed == 0 ? 0 : (double)team.StandingsPoints / (team.GamesPlayed * 2);
}
